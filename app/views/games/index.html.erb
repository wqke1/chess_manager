<div class="toolbar">
  <%= button_to "Importer les nouvelles parties", import_games_path, method: :post %>
  <% if @pending > 0 %>
    <%= button_to "Analyser les #{@pending} parties restantes", analyze_all_games_path, method: :post %>
  <% end %>
  <span class="filters">
    <%= link_to "Toutes", games_path, class: (params[:time_class].blank? ? "on" : nil) %>
    <% %w[bullet blitz rapid daily].each do |tc| %>
      <%= link_to tc, games_path(time_class: tc), class: (params[:time_class] == tc ? "on" : nil) %>
    <% end %>
  </span>
</div>

<% if @games.empty? %>
  <p>Aucune partie en base. Clique sur « Importer ».</p>
<% end %>

<table>
  <thead>
    <tr><th>Date</th><th>Cadence</th><th>Couleur</th><th>Adversaire</th><th>Résultat</th><th>Ouverture</th><th>Précision</th><th>Gaffes</th><th></th></tr>
  </thead>
  <tbody>
    <% @games.each do |g| %>
      <tr class="<%= g.result %>">
        <td><%= l g.played_at, format: :short %></td>
        <td><%= g.time_class %></td>
        <td><%= g.color == "white" ? "♔ blancs" : "♚ noirs" %></td>
        <td><%= g.opponent %> (<%= g.color == "white" ? g.black_rating : g.white_rating %>)</td>
        <td><%= { "win" => "Victoire", "loss" => "Défaite", "draw" => "Nulle" }[g.result] %></td>
        <td><%= g.opening %></td>
        <td><%= g.analyzed? ? "#{g.accuracy}%" : "—" %></td>
        <td><%= g.analyzed? ? g.counts["Gaffe"] : "—" %></td>
        <td><%= link_to "Voir", g %></td>
      </tr>
    <% end %>
  </tbody>
</table>
